{
  "name": "@agv/environmentals",
  "version": "0.7.6",
  "description": "Definition of environmental parameters",
  "main": "dist/src/index.js",
  "files": [
    "translations",
    "dist/src/**/*"
  ],
  "repository": "https://github.com/AGVOLUTION/environmentals",
  "author": "Marcel Schneider <m.schneider@agvolution.com>",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "test": "env TS_NODE_COMPILER_OPTIONS='{\"module\": \"commonjs\" }' mocha -r ts-node/register 'tests/**/*.ts'",
    "build": "yarn generate && yarn tsc",
    "docs": "yarn api-extractor run --verbose --local && yarn api-documenter markdown --input-folder temp --output-folder documentation",
    "generate": "yarn node -r ts-node/register bin/generate.ts",
    "generate-img": "yarn node -r ts-node/register bin/generate_tree_dot.ts| dot -Tsvg>  docs/parameter-tree.svg",
    "yalc-push": "yalc push",
    "clean": "rm -r dist",
    "yalc-gql": "yarn run build && cd generated/gql/ &&  yalc publish"
  },
  "packageManager": "yarn@3.1.1",
  "dependencies": {
    "d3-format": "2",
    "typescript": "^4.5.5"
  },
  "devDependencies": {
    "@microsoft/api-documenter": "^7.19.0",
    "@microsoft/api-extractor": "^7.28.6",
    "@types/chai": "^4",
    "@types/d3-format": "^2",
    "@types/fs-extra": "^9.0.13",
    "@types/lodash": "^4",
    "@types/mocha": "^9",
    "@types/node": "^17.0.10",
    "@types/prettier": "^2",
    "chai": "^4.3.4",
    "class-validator": "^0.13.2",
    "fs-extra": "^10.0.0",
    "graphql": "^16.3.0",
    "lodash": "^4.17.21",
    "madge": "^5.0.1",
    "mocha": "^9.1.4",
    "prettier": "^2.5.1",
    "reflect-metadata": "^0.1.13",
    "ts-node": "^10.4.0",
    "type-graphql": "AGVOLUTION/type-graphql#v1.1.1-withExtendType-package"
  },
  "prettier": {
    "tabWidth": 4
  },
  "workspaces": [
    "generated/*"
  ]
}
