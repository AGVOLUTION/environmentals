    "version": "0.2.0",
    "configurations": [
    {
        "command": "yarn test",
        "name": "Run yarn test",
        "request": "launch",
        "type": "node-terminal"
    },
    {
        "name": "Launch File",
        "program": "${file}",
        "request": "launch",
        "skipFiles": [
            "<node_internals>/**"
        ],
        "type": "node",
        "runtimeArgs": ["--nolazy", "-r", "ts-node/register"],
    },
        {
            "type": "pwa-node",
            "request": "launch",
            "name": "Launch Program",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/bin/traverse.ts",
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ],

        }
    ]
}